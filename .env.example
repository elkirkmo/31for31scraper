# Shared secret required on every /films endpoint and /api/scrape
# (X-API-Key header). Authorises everything, writes included.
ADMIN_API_KEY=change-me

# Optional second key that authorises the READ endpoints only (GET /films,
# GET /films/{id}) -- for handing catalogue access to a consumer without
# handing over the ability to change it. Leave unset (the default) and reads
# accept the admin key alone, which means no third party can read anything.
# A browser-based third-party client would also need CORS headers, which this
# service deliberately does not send.
# READ_API_KEY=

# Supabase (the source of truth). The service-role key bypasses row-level
# security -- server-only, never ship it to a browser. SUPABASE_URL may also
# be provided as PUBLIC_SUPABASE_URL (the frontend's env naming).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
